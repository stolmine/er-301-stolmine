# seq-cv1-c3 -- the headline goal: the sequencer cv1 column, rows 0..5, all at
# C3 = 3.0 V, set via the REAL L1-edit encoder path (ENTER -> editingL1,
# dial->coarse, 3 octave nudges = `turn 9`), NOT a seq:setL1 shortcut.
# Plan: nav home->scope->sequencer, select_column(cv1) (a run-time no-op the
# grid boots on cv1), then 6x set_cell. Mirrors 57-ui-solve-c3-sequencer.test.
context(sequencer)
column_cursor(cv1)
cell(0,cv1,0,3.0)
cell(0,cv1,1,3.0)
cell(0,cv1,2,3.0)
cell(0,cv1,3,3.0)
cell(0,cv1,4,3.0)
cell(0,cv1,5,3.0)
