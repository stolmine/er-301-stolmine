# [stol:infra-crash-diag-hang-watchdog] Inject a synthetic HANG report and confirm
# the format + viewer render it end-to-end without hardware: Kind hang-watchdog,
# a Stack Window section, the on-boot notice, and the admin viewer detail scroll.
# The real hang CAPTURE is am335x-hardware-only (hangs, like traps, do not
# reproduce in the emu); this exercises everything downstream of the panic buffer.

frames 20
!assert app.EMULATION == true

# Inject drops a schema-v2 hang report (with a Stack Window) + a pending marker.
lua require('CrashReport').injectSynthetic('hang-watchdog')
!assert require('CrashReport').hasPending() == true

# The parser recovers the report and its kind.
!assert #require('CrashReport').parseReports() == 1
!assert require('CrashReport').parseReports()[1].kind == 'hang-watchdog'

# The block carries a Stack Window section (the hang-only backtrace payload).
!assert (function() for _,l in ipairs(require('CrashReport').parseReports()[1].lines) do if l:find('Stack Window') then return true end end return false end)()

# [stol:crashdiag-hang-spin-pc] ...and a Hang State line (spin vs blocked).
!assert (function() for _,l in ipairs(require('CrashReport').parseReports()[1].lines) do if l:find('Hang State: running') then return true end end return false end)()

# On-boot notice fires off the pending marker.
lua require('CrashReport').checkPendingOnBoot()
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'MainMessage'
press ENTER
frames 20
!assert require('CrashReport').hasPending() == false

# The admin viewer lists it and renders the detail scroll (incl. the Stack Window).
lua require('CrashReportViewer'):show()
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'CrashReportViewer'
!assert require('CrashReportViewer'):size() == 1
!assert require('CrashReportViewer').reportColumn:get(0):find('hang%-watchdog') ~= nil

press SUB1
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'CrashReportDetail'
!assert require('Application').getVisibleContext():top():size() > 5

quit
