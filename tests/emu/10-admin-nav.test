# Admin navigation: home -> admin via the STORAGE toggle (edge in ui-map.toml),
# confirmed by the node's recognize predicate (state assertion — robust across
# build environments). A pixel !golden was dropped here 2026-07-10: the admin
# menu's text renders slightly differently on fresh builds (font substitution),
# so the screenshot was env-fragile while adding nothing the state assertions
# below don't already prove. See ledger emu-admin-golden-fragile. Prefer the
# state (uiState) + trace tiers over pixel goldens for navigation.

frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'Chain.Root'

# STORAGE toggle to center selects AdminMode.
storage center
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'Menu' and require('Application').getVisibleContext():getInstanceName() == 'Admin'

quit
