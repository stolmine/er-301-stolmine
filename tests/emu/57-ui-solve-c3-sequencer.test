# [stol:ui-planner-solver] Solver acceptance: the C3 sequencer goal, REALIZED.
#
# ui_solve.py plans the goal
#   {context(sequencer), column_cursor(cv1), cell(0,cv1,0..5,3.0)}
# to  nav(home->scope->sequencer) + select_column(cv1) + 6x set_cell,
# and `tools/ui_solve.py --run` drives + verifies it live (report transcript).
# This pins the committed REAL-gesture realization so the suite regression-
# guards it hermetically: each cell is set via the L1-edit encoder path
# (ENTER -> editingL1, dial -> COARSE, `turn 9` = 3 coarse octave-nudges),
# NOT a seq:setL1 shortcut. cv1's coarse step is 1 octave = 1.0 V, so
# 3 coarse steps take a cell 0.0 -> 3.0 V ("C3"). select_column(cv1) is a
# no-op the solver skips (the grid boots with columnCursor already on cv1;
# pressing MAIN1 there would enter edit, so the solver drives nothing).
!packages core

frames 20
!assert require('emu.UIState').topClass() == 'Chain.Root'

# ── nav_home_to_scope + nav_scope_to_sequencer ───────────────────────────────
mode down
frames 10
down SHIFT
press ENTER
up SHIFT
frames 10
!assert require('emu.UIState').topClass() == 'Sequencer.GridView'
# column_cursor(cv1) already holds on entry -> select_column(cv1) is skipped.
!assert require('Application').getVisibleContext():top().columnCursor == 0

# ── set_cell(0,cv1,0,3.0): enter L1 edit, dial->coarse, 3 octave nudges ───────
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editingL1 == true
press DIAL1
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,0)) == '3.0000'

# ── set_cell rows 1..5: nav down 1 row, edit (COARSE persists), 3 nudges ──────
# row 1
turn 3
frames 6
!assert require('Application').getVisibleContext():top().focusHeadRow == 1
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,1)) == '3.0000'

# row 2
turn 3
frames 6
!assert require('Application').getVisibleContext():top().focusHeadRow == 2
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,2)) == '3.0000'

# row 3
turn 3
frames 6
!assert require('Application').getVisibleContext():top().focusHeadRow == 3
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,3)) == '3.0000'

# row 4
turn 3
frames 6
!assert require('Application').getVisibleContext():top().focusHeadRow == 4
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,4)) == '3.0000'

# row 5
turn 3
frames 6
!assert require('Application').getVisibleContext():top().focusHeadRow == 5
press ENTER
frames 6
!assert require('Application').getVisibleContext():top().editStepMode == 'coarse'
turn 9
frames 6
press UP
frames 6
!assert string.format('%.4f', app.AudioThread.getSequencerTask():l1Value(0,0,5)) == '3.0000'

# ── FINAL: satisfies({column_cursor(cv1), cell(0,cv1,0..5,3.0)}) ─────────────
!assert require('Application').getVisibleContext():top().columnCursor == 0
!assert (function() local s=app.AudioThread.getSequencerTask(); for r=0,5 do if math.abs(s:l1Value(0,0,r)-3.0)>1e-4 then return false end end return true end)()
quit
