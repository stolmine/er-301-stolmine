# Open the dense unit picker from the empty boot chain and confirm arrival.
# pickerStyle is forced to 'dense' by the settings fixture, so the chooser window
# is Unit.Chooser.Dense.

# Core mods give the picker real contents. If integration shows the picker opens
# fine without them, this directive can be dropped.
!packages core

frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'Chain.Root'

# On the empty boot chain an InsertControl is focused; ENTER opens the chooser.
# (If ENTER does not land on an insert slot at boot, add a focus gesture here —
# see the unit_picker_dense edge note in ui-map.toml.)
press ENTER
frames 15
!assert require('Application').getVisibleContext():top():getClassName() == 'Unit.Chooser.Dense'

quit

