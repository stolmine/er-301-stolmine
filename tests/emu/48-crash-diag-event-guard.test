# [stol:crashdiag-object-guard-event] Inject a synthetic report carrying an
# --- Event Guard --- section (the audio Event's pendQ caught clobbered before
# Event_post would trap) and confirm the format + viewer render it end-to-end
# without hardware: the Event Guard section, the top-of-report EVENT GUARD BREACH
# banner, the on-boot notice, and the admin viewer detail scroll. The real
# per-breach CAPTURE is am335x-hardware-only (the wild write only lands on the
# target memory map); this exercises everything downstream of the panic buffer,
# so C flush / Lua injector / symbolizer agree.

frames 20
!assert app.EMULATION == true

# Inject drops a schema-v2 event-guard-breach report + a pending marker.
lua require('CrashReport').injectSynthetic('event-guard-breach')
!assert require('CrashReport').hasPending() == true

# The parser recovers exactly one report; its kind is event-guard-breach.
!assert #require('CrashReport').parseReports() == 1
!assert require('CrashReport').parseReports()[1].kind == 'event-guard-breach'

# The block carries an --- Event Guard --- section header.
!assert (function() for _,l in ipairs(require('CrashReport').parseReports()[1].lines) do if l:find('%-%-%- Event Guard %-%-%-') then return true end end return false end)()

# ...a pendQ/next/prev/reason data line showing the corrupted near-null next.
!assert (function() for _,l in ipairs(require('CrashReport').parseReports()[1].lines) do if l:find('pendQ=') and l:find('next=00000062') then return true end end return false end)()

# ...and the prominent top-of-report EVENT GUARD BREACH banner (unmissable).
!assert (function() for _,l in ipairs(require('CrashReport').parseReports()[1].lines) do if l:find('%*%*%* EVENT GUARD BREACH') then return true end end return false end)()

# On-boot notice fires off the pending marker.
lua require('CrashReport').checkPendingOnBoot()
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'MainMessage'
press ENTER
frames 20
!assert require('CrashReport').hasPending() == false

# The admin viewer lists it and renders the detail scroll (incl. the Event Guard section).
lua require('CrashReportViewer'):show()
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'CrashReportViewer'
!assert require('CrashReportViewer'):size() == 1
!assert require('CrashReportViewer').reportColumn:get(0):find('event%-guard%-breach') ~= nil

press SUB1
frames 20
!assert require('Application').getVisibleContext():top():getClassName() == 'CrashReportDetail'
!assert require('Application').getVisibleContext():top():size() > 5

quit
