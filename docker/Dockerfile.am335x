FROM --platform=linux/amd64 ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TI_INSTALL_DIR=/root/ti

# Build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    swig \
    python3 \
    zip \
    gcc-multilib \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Download TI SDK (~1.5GB) — split from install so progress is visible
RUN echo "=== Downloading TI Processor SDK ===" \
    && wget --progress=dot:mega \
       http://software-dl.ti.com/processor-sdk-rtos/esd/AM335X/04_01_00_06/exports/ti-processor-sdk-rtos-am335x-evm-04.01.00.06-Linux-x86-Install.bin \
       -O /tmp/ti-sdk.bin \
    && echo "=== Download complete: $(du -h /tmp/ti-sdk.bin | cut -f1) ==="

# Install TI SDK (runs under QEMU, may take several minutes)
RUN echo "=== Installing TI SDK (this takes 10-20 min under QEMU) ===" \
    && chmod +x /tmp/ti-sdk.bin \
    && /tmp/ti-sdk.bin --prefix /root/ti --mode unattended --debuglevel 4 \
    && echo "=== Install complete ===" \
    && ls /root/ti/ \
    && rm /tmp/ti-sdk.bin

WORKDIR /er-301
